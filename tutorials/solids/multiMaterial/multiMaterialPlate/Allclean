#!/bin/bash

# Source tutorial clean functions
. $WM_PROJECT_DIR/bin/tools/CleanFunctions

# Source solids4Foam scripts
source solids4FoamScripts.sh

cleanCase
rm -rf postProcessing *.png fit.log

# Restore the stored case format
solids4Foam::restoreCaseFormat .

# Remove the dictionaries created by Allrun
rm -f system/blockMeshDict system/sample system/sampleDict
rm -f constant/mechanicalProperties

# Remove the regression test cases too with ./Allclean all
if [ "${1:-}" = "all" ]
then
    rm -rf regressionTests
fi
